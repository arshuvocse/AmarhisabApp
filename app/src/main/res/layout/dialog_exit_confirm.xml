<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glossy_dialog"
    android:padding="22dp">

    <!-- Icon -->
    <LinearLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:background="@drawable/bg_glossy_badge_blue"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#3B82F6"
            android:contentDescription="Exit Icon" />
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="অ্যাপ বন্ধ করবেন?"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="আপনি কি সত্যিই আমার হিসাব অ্যাপ থেকে বের হয়ে যেতে চান?"
        android:textColor="#E2E8F0"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="22dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnExitConfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="হ্যাঁ, বের হবো"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glossy_btn_primary"
            app:backgroundTint="@null"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnExitCancel"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="না, থাকবো"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
